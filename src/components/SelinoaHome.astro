    malleyBig: "Sept. 2026",
    malleySm: "Malley Center · Lausanne",
    faqEyebrow: "Your questions",
    faqH2: "What you're surely wondering.",
    faq: [
      { q: "It's a budget. Why is it worth it?", a: "Add up what you already spend: yoga, osteo, supplements, consultations. It's often more, and without lasting results because nothing is connected. Here, everything is coordinated and included in a single subscription, around a common goal." },
      { q: "I've already tried everything, why would this work?", a: "Precisely: if nothing held, it's often because each thing moved on its own, in its corner. Our role isn't to add one more method. It's to coordinate everything — which no one had done for you." },
      { q: "I don't have time.", a: "That's exactly why the care manager exists: she carries the logistics for you — appointments, follow-up, coordination. The program is designed to take load off you, not add to it." },
      { q: "Why not just my GP?", a: "They do essential work, but don't have time to coordinate movement, bodywork and follow-up between consultations. We work with them, not against them." },
      { q: "Is it covered by insurance?", a: "It's a private program, not reimbursed as such. Certain individual services may be, depending on your situation. We discuss it during the first call." },
      { q: "And if it's not for me?", a: "The first call is free and without commitment. We look together at whether the program matches what you're going through, and if it's not a fit, we'll tell you." },
    ],
    finalH2a: "What if you stopped ",
    finalH2em: "carrying it all alone?",
    finalP: "It all starts with a free, no-commitment call. The first group is limited to 8 participants.",
    finalBtn: "Book my free call →",
    footTagline: "Coordinated support for women who can't carry it all anymore. Lausanne, Switzerland.",
    footColTitle: "The program",
    footContact: "Contact",
    footCopyright: "© 2026 Selinoa · Médecin Neyret Adner, sole proprietorship · Route de Cossonay 102, 1008 Prilly · CHE-487.966.272",
    footLegal: "Legal notice",
    footPrivacy: "Privacy",
    footCompliance: "nFADP compliant",
  },
} as const;

const t = T[lang];
const check = `<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="9" fill="#EBEFE3"/><path d="M5 9.2l2.4 2.4L13 6.4" stroke="#566048" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const lock = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none"><rect x="4" y="10" width="16" height="11" rx="2.5" stroke="#2D2329" stroke-width="1.7"/><path d="M8 10V7a4 4 0 018 0v3" stroke="#2D2329" stroke-width="1.7"/></svg>`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.htmlTitle}</title>
    <meta name="description" content={t.metaDesc} />
    <meta name="theme-color" content="#6D2E46" />
    <link rel="canonical" href={brandHome} />
    <link rel="alternate" hreflang="fr" href="https://selinoa.ch/" />
    <link rel="alternate" hreflang="en" href="https://selinoa.ch/en/" />
    <link rel="alternate" hreflang="x-default" href="https://selinoa.ch/" />
    <meta property="og:title" content={t.htmlTitle} />
    <meta property="og:description" content={t.metaDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "fr_CH"} />
    <meta property="og:url" content={brandHome} />
    <meta property="og:image" content="https://selinoa.ch/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.htmlTitle} />
    <meta property="og:site_name" content="Selinoa" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.htmlTitle} />
    <meta name="twitter:description" content={t.metaDesc} />
    <meta name="twitter:image" content="https://selinoa.ch/og-image.png" />
    {/* Polices Fraunces + Inter embarquées (base64) — rendu identique à la maquette */}
    {/* Tracking (GA4 + Google Ads) — page de conversion clé */}
    {tracking.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${tracking.ga4Id}`}></script>
        <script set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${tracking.ga4Id}', { 'anonymize_ip': true });
          ${tracking.googleAdsId ? `gtag('config', '${tracking.googleAdsId}');` : ""}
        `}></script>
      </>
    )}
    <style is:global>
      @font-face{font-family:'Fraunces';font-weight:400;font-style:normal;src:url(data:font/woff2;base64,) format('woff2');font-display:swap;}
      @font-face{font-family:'Fraunces';font-weight:600;font-style:normal;src:url(data:font/woff2;base64,) format('woff2');font-display:swap;}
      @font-face{font-family:'Inter';font-weight:400;src:url(data:font/woff2;base64,) format('woff2');font-display:swap;}
      @font-face{font-family:'Inter';font-weight:500;src:url(data:font/woff2;base64,) format('woff2');font-display:swap;}
      @font-face{font-family:'Inter';font-weight:600;src:url(data:font/woff2;base64,) format('woff2');font-display:swap;}
      :root{
        --aub:#6D2E46;--aub-deep:#46202F;--sage:#7C8A6B;--sage-deep:#566048;
        --paper:#FCFAF6;--card:#F4EDE8;--sage-tint:#EBEFE3;--ink:#2D2329;--muted:#7C6C72;--line:rgba(70,32,47,.12);--gold:#B07A3C;
      }
      *{margin:0;padding:0;box-sizing:border-box;}
      html{scroll-behavior:smooth;}
      body{font-family:'Inter',sans-serif;color:var(--ink);background:var(--paper);-webkit-font-smoothing:antialiased;line-height:1.6;font-size:16px;}
      h1,h2,h3{font-family:'Fraunces',serif;font-weight:600;line-height:1.1;letter-spacing:-.01em;}
      a{color:inherit;text-decoration:none;}
      .wrap{max-width:1080px;margin:0 auto;padding:0 24px;}
      .eyebrow{font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--sage-deep);}
      .btn{display:inline-flex;align-items:center;gap:8px;font-family:'Inter';font-weight:600;font-size:15px;padding:14px 26px;border-radius:40px;border:none;cursor:pointer;transition:transform .15s ease,box-shadow .15s ease;}
      .btn-primary{background:var(--aub);color:#fff;box-shadow:0 6px 20px rgba(109,46,70,.22);}
      .btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(109,46,70,.3);}
      .btn-ghost{background:transparent;color:var(--aub);border:1.5px solid rgba(109,46,70,.3);}
      .btn-ghost:hover{border-color:var(--aub);}
      .btn-sage{background:var(--sage-deep);color:#fff;}
      .btn-sage:hover{transform:translateY(-2px);}
      .btn-headcta{background:#fff;color:var(--aub);border:1.5px solid var(--aub);box-shadow:0 2px 10px rgba(109,46,70,.15);}
      .btn-headcta:hover{background:var(--aub);color:#fff;transform:translateY(-2px);}

      /* header */
      header{position:sticky;top:0;z-index:50;background:rgba(252,250,246,.86);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);}
      .nav{display:flex;align-items:center;justify-content:space-between;height:64px;}
      .logo{font-weight:600;font-size:16px;letter-spacing:.26em;color:var(--aub);}
      .nav-links{display:flex;gap:28px;align-items:center;}
      .nav-links a{font-size:14px;color:var(--ink);font-weight:500;}
      .nav-links a:not(.btn):not(.lang-switch):hover{color:var(--aub);}
      .lang-switch{font-size:13px;font-weight:600;letter-spacing:.05em;color:var(--sage-deep)!important;border:1px solid var(--line);border-radius:30px;padding:5px 11px;transition:background .15s,color .15s;}
      .lang-switch:hover{background:var(--sage-tint);color:var(--aub)!important;}
      .nav .btn{padding:10px 20px;font-size:14px;}
      .menu-toggle{display:none;}
      @media(max-width:860px){.nav-links a:not(.btn){display:none;}}

      /* hero */
      .hero{padding:74px 0 64px;position:relative;overflow:hidden;}
      .hero::before{content:"";position:absolute;top:-120px;right:-120px;width:420px;height:420px;background:radial-gradient(circle,rgba(124,138,107,.18),transparent 70%);border-radius:50%;}
      .hero-eyebrow{margin-bottom:20px;display:inline-block;}
      .hero h1{font-size:clamp(38px,6vw,62px);max-width:16ch;margin-bottom:22px;color:var(--aub);}
      .hero h1 em{font-style:italic;color:var(--sage-deep);}
      .hero .lead{font-size:19px;color:var(--muted);max-width:54ch;margin-bottom:32px;}
      .hero-cta{display:flex;gap:14px;flex-wrap:wrap;align-items:center;}
      .hero-rsr{margin-top:18px;font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px;}
      .hero-rsr svg{flex:none;}
      .trust{margin-top:44px;display:flex;flex-wrap:wrap;gap:10px 28px;padding-top:26px;border-top:1px solid var(--line);}
      .trust span{font-size:13px;font-weight:500;color:var(--ink);display:flex;align-items:center;gap:8px;}
      .trust .dot{width:6px;height:6px;border-radius:50%;background:var(--sage);}

      /* generic section */
      section{padding:60px 0;}
      .sec-head{max-width:60ch;margin-bottom:40px;}
      .sec-head .eyebrow{display:block;margin-bottom:14px;}
      .sec-head h2{font-size:clamp(28px,4vw,40px);color:var(--aub);margin-bottom:14px;}
      .sec-head p{font-size:17px;color:var(--muted);}

      /* steps */
      .steps{display:grid;grid-template-columns:repeat(2,1fr);gap:22px;}
      .step{display:flex;gap:16px;align-items:flex-start;}
      .step .n{flex:none;width:42px;height:42px;border-radius:50%;background:var(--sage-tint);color:var(--sage-deep);font-family:'Fraunces';font-weight:600;font-size:18px;display:flex;align-items:center;justify-content:center;}
      .step h3{font-size:18px;color:var(--ink);margin-bottom:5px;}
      .step p{font-size:14.5px;color:var(--muted);}
      .assetnote{margin-top:28px;background:var(--sage-tint);border-radius:14px;padding:18px 22px;font-size:14.5px;color:var(--sage-deep);}
      .assetnote b{font-weight:600;}
      @media(max-width:760px){.steps{grid-template-columns:1fr;}}

      /* included */
      .included{background:var(--card);}
      .inc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px 36px;}
      .inc{display:flex;gap:12px;align-items:flex-start;font-size:15.5px;}
      .inc svg{flex:none;margin-top:3px;}
      .inc b{font-weight:600;}
      @media(max-width:760px){.inc-grid{grid-template-columns:1fr;}}

      /* pricing */
      .prices{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:start;}
      .price{background:#fff;border:1px solid var(--line);border-radius:20px;padding:30px 26px;display:flex;flex-direction:column;position:relative;}
      .tag.sagetag{background:var(--sage-deep);}
      .price li.life{font-weight:600;color:var(--sage-deep);}
      .price li.life::before{border-color:var(--sage-deep);}

      /* comparatif */
      .compare{background:var(--card);}
      .ctable{width:100%;border-collapse:collapse;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 10px 30px rgba(70,32,47,.07);}
      .ctable th,.ctable td{padding:15px 20px;text-align:left;font-size:14.5px;border-bottom:1px solid var(--line);}
      .ctable thead th{font-family:'Fraunces';font-weight:600;font-size:15px;background:var(--paper);}
      .ctable thead th:last-child{color:var(--aub);}
      .ctable td:first-child{font-weight:500;color:var(--ink);width:34%;}
      .ctable td.classic{color:var(--muted);}
      .ctable td.nova{color:var(--aub);font-weight:600;background:rgba(109,46,70,.04);}
      .ctable tr:last-child td{border-bottom:none;}
      @media(max-width:760px){.ctable th,.ctable td{padding:11px 12px;font-size:12.5px;}}

      /* science / credibility */
      .science{background:var(--aub);color:#fff;}
      .science .eyebrow{color:#D9A8B8;}
      .science h2{color:#fff;font-size:clamp(28px,4vw,40px);max-width:20ch;margin:14px 0 16px;}
      .science .intro{color:#EAD9DE;font-size:17px;max-width:60ch;margin-bottom:38px;}
      .sci-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-bottom:30px;}
      .sci-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.13);border-radius:16px;padding:26px;}
      .sci-card .k{font-family:'Fraunces';font-weight:600;font-size:15px;color:var(--gold);margin-bottom:9px;letter-spacing:.02em;}
      .sci-card h3{font-size:19px;color:#fff;margin-bottom:9px;}
      .sci-card p{font-size:14px;color:#EAD9DE;line-height:1.55;}
      .sci-inst{display:flex;flex-wrap:wrap;gap:10px 14px;align-items:center;padding-top:24px;border-top:1px solid rgba(255,255,255,.15);}
      .sci-inst .lbl{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#D9A8B8;width:100%;margin-bottom:4px;}
      .sci-inst span.inst{font-size:13.5px;color:#fff;background:rgba(255,255,255,.08);border-radius:20px;padding:6px 14px;}
      .science .disclaimer{font-size:12px;color:#C99FAD;font-style:italic;margin-top:22px;max-width:64ch;}
      @media(max-width:760px){.sci-grid{grid-template-columns:1fr;}}
      .price.feat{border:2px solid var(--aub);box-shadow:0 16px 40px rgba(109,46,70,.13);position:relative;}
      .price .tag{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:var(--aub);color:#fff;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:5px 14px;border-radius:20px;}
      .price h3{font-size:22px;color:var(--aub);margin-bottom:4px;}
      .price .who{font-size:13px;color:var(--muted);margin-bottom:18px;min-height:34px;}
      .price .amt{font-family:'Fraunces';font-weight:600;font-size:40px;color:var(--ink);line-height:1;}
      .price .amt small{font-family:'Inter';font-size:15px;font-weight:500;color:var(--muted);}
      .price .eng{font-size:12.5px;color:var(--muted);margin:6px 0 20px;}
      .price ul{list-style:none;margin-bottom:24px;flex:1;}
      .price li{font-size:14px;padding:7px 0 7px 24px;position:relative;border-top:1px solid var(--line);}
      .price li:first-child{border-top:none;}
      .price li::before{content:"";position:absolute;left:0;top:13px;width:11px;height:6px;border-left:2px solid var(--sage);border-bottom:2px solid var(--sage);transform:rotate(-45deg);}
      .price .btn{width:100%;justify-content:center;}
      .pay-rsr{margin-top:28px;text-align:center;font-size:13.5px;color:var(--muted);display:flex;flex-direction:column;gap:6px;align-items:center;}
      .pay-rsr .secure{display:inline-flex;align-items:center;gap:7px;font-weight:500;color:var(--ink);}
      @media(max-width:860px){.prices{grid-template-columns:1fr;max-width:420px;margin:0 auto;}}

      /* founder */
      .founder{display:flex;gap:36px;align-items:center;}
      .founder .ph{flex:none;width:96px;height:96px;border-radius:50%;background:var(--sage-tint);color:var(--sage-deep);font-family:'Fraunces';font-size:34px;font-weight:600;display:flex;align-items:center;justify-content:center;}
      .founder blockquote{font-family:'Fraunces';font-style:italic;font-size:21px;line-height:1.4;color:var(--aub);margin-bottom:12px;}
      .founder cite{font-style:normal;font-size:14px;color:var(--muted);font-weight:500;}
      @media(max-width:660px){.founder{flex-direction:column;text-align:center;}}

      /* malley phase 2 */
      .malley{background:var(--sage-tint);}
      .malley-in{display:flex;gap:40px;align-items:center;justify-content:space-between;flex-wrap:wrap;}
      .malley-in .txt{max-width:54ch;}
      .malley .eyebrow{color:var(--sage-deep);}
      .malley h2{font-size:clamp(26px,3.5vw,34px);color:var(--aub);margin:12px 0 12px;}
      .malley p{color:var(--ink);font-size:16px;}
      .malley .badge{flex:none;background:#fff;border-radius:16px;padding:22px 26px;text-align:center;box-shadow:0 8px 24px rgba(70,32,47,.08);}
      .malley .badge .big{font-family:'Fraunces';font-weight:600;font-size:24px;color:var(--aub);}
      .malley .badge .sm{font-size:12.5px;color:var(--muted);margin-top:4px;}

      /* faq */
      .faq-item{border-bottom:1px solid var(--line);padding:20px 0;}
      .faq-item summary{font-family:'Fraunces';font-weight:600;font-size:18px;color:var(--ink);cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:16px;align-items:center;}
      .faq-item summary::-webkit-details-marker{display:none;}
      .faq-item summary .plus{flex:none;width:24px;height:24px;border-radius:50%;border:1.5px solid var(--sage);color:var(--sage-deep);display:flex;align-items:center;justify-content:center;font-size:18px;transition:transform .2s;}
      .faq-item[open] summary .plus{transform:rotate(45deg);}
      .faq-item p{margin-top:12px;font-size:15px;color:var(--muted);max-width:70ch;}

      /* final cta */
      .final{text-align:center;padding:80px 0;}
      .final h2{font-size:clamp(30px,4.5vw,46px);color:var(--aub);max-width:18ch;margin:0 auto 18px;}
      .final h2 em{font-style:italic;color:var(--sage-deep);}
      .final p{color:var(--muted);font-size:17px;max-width:50ch;margin:0 auto 30px;}

      /* footer */
      footer{background:var(--aub);color:#fff;padding:48px 0 30px;}
      .foot-top{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;margin-bottom:34px;}
      .foot-brand{max-width:30ch;}
      .foot-brand .logo{color:#fff;margin-bottom:12px;display:block;}
      .foot-brand p{font-size:13.5px;color:#EAD9DE;}
      .foot-col h4{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#D9A8B8;margin-bottom:12px;font-family:'Inter';font-weight:600;}
      .foot-col a{display:block;font-size:13.5px;color:#EAD9DE;margin-bottom:8px;}
      .foot-col a:hover{color:#fff;}
      .foot-bottom{border-top:1px solid rgba(255,255,255,.15);padding-top:20px;font-size:12px;color:#D9A8B8;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;}
      .reveal{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease;}
      .reveal.in{opacity:1;transform:none;}
      @media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none;}.btn{transition:none;}}

      .problem{background:var(--paper);}
      .tried{display:flex;flex-wrap:wrap;gap:10px;margin:4px 0 24px;}
      .tried span{font-size:14px;color:var(--muted);background:#fff;border:1px solid var(--line);border-radius:20px;padding:7px 16px;}
      .orchestra{background:var(--card);border-left:4px solid var(--sage);border-radius:0 16px 16px 0;padding:26px 30px;}
      .orchestra p{font-family:'Fraunces';font-style:italic;font-size:20px;line-height:1.5;color:var(--aub);}
      .orchestra .punch{font-family:'Inter';font-style:normal;font-weight:600;font-size:16px;color:var(--ink);margin-top:14px;}
      .inaction{background:var(--aub-deep);color:#fff;text-align:center;}
      .inaction .eyebrow{color:var(--gold);display:block;margin-bottom:14px;}
      .inaction h2{color:#fff;font-size:clamp(26px,4vw,38px);max-width:22ch;margin:0 auto 30px;}
      .inaction-grid{display:flex;justify-content:center;gap:26px;flex-wrap:wrap;margin-bottom:28px;}
      .inaction-grid div{max-width:230px;}
      .inaction-grid h3{font-family:'Fraunces';font-weight:600;font-size:17px;color:#F2D9E0;margin-bottom:6px;}
      .inaction-grid p{font-size:14px;color:#E3C7D0;line-height:1.5;}
      .inaction .punch{font-family:'Fraunces';font-style:italic;font-size:21px;color:#fff;}
      .unique{background:var(--sage-tint);}
      .unique .eyebrow{color:var(--sage-deep);}
      .maj{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:30px;}
      .maj-card{background:#fff;border-radius:16px;padding:24px;box-shadow:0 8px 24px rgba(86,96,72,.08);}
      .maj-card .ic{font-family:'Fraunces';font-weight:600;font-size:14px;color:var(--sage-deep);letter-spacing:.04em;margin-bottom:10px;}
      .maj-card h3{font-size:17px;color:var(--ink);margin-bottom:6px;}
      .maj-card p{font-size:14px;color:var(--muted);line-height:1.5;}
      .unique .allin{text-align:center;font-family:'Fraunces';font-style:italic;font-size:20px;color:var(--aub);margin:32px auto 0;max-width:52ch;}
      .reframe{background:var(--sage-tint);border-radius:14px;padding:18px 24px;font-size:15px;color:var(--ink);max-width:680px;margin:0 auto 32px;text-align:center;line-height:1.55;}
      .reframe b{color:var(--sage-deep);}
      .tier-lead{font-size:11.5px;font-weight:600;letter-spacing:.05em;color:var(--sage-deep);text-transform:uppercase;margin-bottom:8px;}
      .testimonial{background:var(--paper);}
      .tcard{max-width:760px;margin:0 auto;text-align:center;}
      .tcard .quote{font-family:'Fraunces';font-style:italic;font-size:23px;line-height:1.45;color:var(--aub);margin-bottom:16px;}
      .tcard cite{font-style:normal;font-size:14px;color:var(--muted);font-weight:500;}
      .pio{background:var(--aub-deep);color:#fff;text-align:center;}
      .pio .eyebrow{color:var(--gold);}
      .pio h2{color:#fff;font-size:clamp(28px,4vw,42px);max-width:18ch;margin:14px auto 16px;}
      .pio h2 em{font-style:italic;color:var(--gold);}
      .pio p{color:#EAD9DE;max-width:56ch;margin:0 auto 26px;font-size:16px;}
      .urgency{display:inline-block;background:rgba(176,122,60,.2);border:1px solid var(--gold);color:#F2D9E0;border-radius:30px;padding:9px 22px;font-size:14px;font-weight:500;margin-top:8px;}
      @media(max-width:760px){.maj{grid-template-columns:1fr;}.inaction-grid{flex-direction:column;align-items:center;}}
    </style>
  </head>
  <body>
    <header>
      <div class="wrap nav">
        <a href="#top" class="logo">SELINOA</a>
        <nav class="nav-links">
          <a href="#probleme">{t.navProbleme}</a>
          <a href="#solution">{t.navApproche}</a>
          <a href="#tarifs">{t.navTarifs}</a>
          <a href="#faq">{t.navQuestions}</a>
          <a href={altUrl} class="lang-switch" hreflang={lang === "en" ? "fr" : "en"} aria-label={altFull}>{altLabel}</a>
          <a href={cta} class="btn btn-headcta">{t.navReserver}</a>
        </nav>
      </div>
    </header>

    <a id="top"></a>
    <section class="hero">
      <div class="wrap">
        <span class="eyebrow hero-eyebrow">{t.heroEyebrow}</span>
        <h1>{t.heroH1a}<em>{t.heroH1em}</em></h1>
        <p class="lead">{t.heroLead}</p>
        <div class="hero-cta">
          <a href={cta} class="btn btn-primary">{t.heroCtaPrimary}</a>
          <a href="#solution" class="btn btn-ghost">{t.heroCtaGhost}</a>
        </div>
        <p class="hero-rsr"><Fragment set:html={lock} />&nbsp;{t.heroRsr}</p>
        <div class="trust">
          {t.trust.map((s) => (<span><span class="dot"></span>{s}</span>))}
        </div>
      </div>
    </section>

    <section id="probleme" class="problem">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">{t.probEyebrow}</span>
          <h2>{t.probH2}</h2>
          <p>{t.probP}</p>
        </div>
        <div class="tried reveal">{t.tried.map((x) => (<span>{x}</span>))}</div>
        <div class="orchestra reveal">
          <p>{t.orchestraQuote}</p>
          <p class="punch">{t.orchestraPunch}</p>
        </div>
      </div>
    </section>

    <section class="inaction">
      <div class="wrap">
        <span class="eyebrow">{t.inactionEyebrow}</span>
        <h2>{t.inactionH2}</h2>
        <div class="inaction-grid reveal">
          {t.inactionGrid.map((x) => (<div><h3>{x.h3}</h3><p>{x.p}</p></div>))}
        </div>
        <p class="punch reveal">{t.inactionPunch}</p>
      </div>
    </section>

    <section id="solution" class="unique">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">{t.uniqueEyebrow}</span>
          <h2>{t.uniqueH2}</h2>
          <p>{t.uniqueP}</p>
        </div>
        <div class="maj">
          {t.maj.map((m) => (<div class="maj-card reveal"><div class="ic">{m.ic}</div><h3>{m.h3}</h3><p>{m.p}</p></div>))}
        </div>
        <p class="allin">{t.allin}</p>
      </div>
    </section>

    <section class="science">
      <div class="wrap">
        <div class="sec-head reveal" style="margin-bottom:0;">
          <span class="eyebrow">{t.sciEyebrow}</span>
          <h2>{t.sciH2}</h2>
          <p class="intro">{t.sciIntro}</p>
        </div>
        <div class="sci-grid">
          {t.sci.map((c) => (<div class="sci-card reveal"><div class="k">{c.k}</div><h3>{c.h3}</h3><p>{c.p}</p></div>))}
        </div>
        <div class="sci-inst">
          <span class="lbl">{t.sciInstLbl}</span>
          {t.sciInst.map((i) => (<span class="inst">{i}</span>))}
        </div>
        <p class="disclaimer">{t.sciDisclaimer}</p>
      </div>
    </section>

    <section id="programme">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">{t.progEyebrow}</span>
          <h2>{t.progH2}</h2>
          <p>{t.progP}</p>
        </div>
        <div class="inc-grid">
          {t.inc.map((i) => (<div class="inc reveal"><Fragment set:html={check} /><span><b>{i.b}</b>{i.rest}</span></div>))}
        </div>
      </div>
    </section>

    <section id="etapes" class="included">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">{t.stepsEyebrow}</span>
          <h2>{t.stepsH2}</h2>
          <p>{t.stepsP}</p>
        </div>
        <div class="steps">
          {t.steps.map((s, i) => (<div class="step reveal"><div class="n">{i + 1}</div><div><h3>{s.h3}</h3><p>{s.p}</p></div></div>))}
        </div>
        <div class="assetnote reveal"><b>{t.assetNoteB}</b>{t.assetNoteRest}</div>
      </div>
    </section>

    <section id="tarifs">
      <div class="wrap">
        <div class="sec-head reveal" style="text-align:center;margin-left:auto;margin-right:auto;">
          <span class="eyebrow">{t.tarifsEyebrow}</span>
          <h2>{t.tarifsH2}</h2>
          <p style="margin-left:auto;margin-right:auto;">{t.tarifsP}</p>
        </div>
        <div class="reframe reveal">{t.reframeA}<b>{t.reframeB}</b>{t.reframeC}<b>{t.reframeD}</b>{t.reframeE}</div>
        <div class="prices">
          {t.plans.map((p) => (
            <div class={`price reveal${p.featured ? " feat" : ""}`}>
              {p.tag && <span class={`tag${p.sageTag ? " sagetag" : ""}`}>{p.tag}</span>}
              <p class="tier-lead">{p.tierLead}</p>
              <h3>{p.name}</h3>
              <p class="who">{p.who}</p>
              <div class="amt">{p.amt} <small>{p.per}</small></div>
              <p class="eng">{p.eng}</p>
              <ul>
                {p.items.map((it) => (<li class={it.life ? "life" : ""}>{it.t}</li>))}
              </ul>
              <a href={cta} class={`btn ${p.featured ? "btn-primary" : "btn-ghost"}`}>{p.btn}</a>
            </div>
          ))}
        </div>
        <div class="pay-rsr">
          <span class="secure"><Fragment set:html={lock} />&nbsp;{t.paySecure}</span>
          <span>{t.payNote}</span>
        </div>
      </div>
    </section>

    <section class="compare">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">{t.cmpEyebrow}</span>
          <h2>{t.cmpH2}</h2>
          <p>{t.cmpP}</p>
        </div>
        <table class="ctable reveal">
          <thead><tr><th>&nbsp;</th><th>{t.cmpHead[1]}</th><th>{t.cmpHead[2]}</th></tr></thead>
          <tbody>
            {t.cmpRows.map((r) => (<tr><td>{r[0]}</td><td class="classic">{r[1]}</td><td class="nova">{r[2]}</td></tr>))}
          </tbody>
        </table>
        <p style="text-align:center;font-size:13.5px;color:var(--muted);margin-top:18px;">{t.cmpNote}</p>
      </div>
    </section>

    <section class="testimonial">
      <div class="wrap tcard reveal">
        <span class="eyebrow" style="display:block;margin-bottom:18px;">{t.testEyebrow}</span>
        <p class="quote">{t.testQuote}</p>
        <cite>{t.testCite}</cite>
      </div>
    </section>

    <section class="pio">
      <div class="wrap">
        <span class="eyebrow">{t.pioEyebrow}</span>
        <h2>{t.pioH2a}<em>{t.pioH2em}</em></h2>
        <p>{t.pioP}</p>
        <div><span class="urgency">{t.pioUrgency}</span></div>
        <div style="margin-top:26px;"><a href={cta} class="btn btn-sage">{t.pioBtn}</a></div>
      </div>
    </section>

    <section class="malley">
      <div class="wrap malley-in">
        <div class="txt reveal">
          <span class="eyebrow">{t.malleyEyebrow}</span>
          <h2>{t.malleyH2}</h2>
          <p>{t.malleyP}</p>
        </div>
        <div class="badge reveal"><div class="big">{t.malleyBig}</div><div class="sm">{t.malleySm}</div></div>
      </div>
    </section>

    <section id="faq">
      <div class="wrap">
        <div class="sec-head reveal"><span class="eyebrow">{t.faqEyebrow}</span><h2>{t.faqH2}</h2></div>
        {t.faq.map((f) => (
          <details class="faq-item reveal">
            <summary>{f.q} <span class="plus">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="final" id="reserver">
      <div class="wrap">
        <h2>{t.finalH2a}<em>{t.finalH2em}</em></h2>
        <p>{t.finalP}</p>
        <a href={cta} class="btn btn-primary">{t.finalBtn}</a>
      </div>
    </section>

    <footer>
      <div class="wrap">
        <div class="foot-top">
          <div class="foot-brand">
            <span class="logo">SELINOA</span>
            <p>{t.footTagline}</p>
          </div>
          <div class="foot-col">
            <h4>{t.footColTitle}</h4>
            <a href="#probleme">{t.navProbleme}</a>
            <a href="#solution">{t.navApproche}</a>
            <a href="#tarifs">{t.navTarifs}</a>
            <a href="#faq">{t.navQuestions}</a>
          </div>
          <div class="foot-col">
            <h4>{t.footContact}</h4>
            <a href="mailto:dr.aneyret@hin.ch">dr.aneyret@hin.ch</a>
            <a href="tel:+41783348835">+41 78 334 88 35</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>{t.footCopyright}</span>
          <span><a href={legalUrl}>{t.footLegal}</a> · <a href={privacyUrl}>{t.footPrivacy}</a> · {t.footCompliance}</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Révélation au scroll (identique à l'original)
      (function () {
        var els = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) {
          els.forEach(function (e) { e.classList.add("in"); });
          return;
        }
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
          });
        }, { threshold: 0.12 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
