---
/**
 * LandingHero — Hero générique pour les landing pages thématiques
 *
 * Props :
 *  - eyebrow : petit label sur fond berry (ex: "Ménopause · Périménopause")
 *  - titleLine1 : 1ère partie du titre (avant le mot italique)
 *  - titleEm    : mot/expression en italique berry (mot-clé principal)
 *  - titleLine2 : 2ème partie après l'italique
 *  - intro      : paragraphe d'intro (mots-clés secondaires)
 *  - ctaPrimary, ctaSecondary : libellés des deux CTAs
 *  - source     : valeur de data-track-source pour le tracking (ex: "lp_menopause")
 */

interface Props {
  eyebrow: string;
  titleLine1: string;
  titleEm: string;
  titleLine2?: string;
  intro: string;
  introEm?: string;
  introSuffix?: string;
  ctaPrimary: string;
  ctaSecondary: string;
  source: string;
}

const {
  eyebrow,
  titleLine1,
  titleEm,
  titleLine2 = '',
  intro,
  introEm,
  introSuffix,
  ctaPrimary,
  ctaSecondary,
  source,
} = Astro.props;
---

<section class="landing-hero" aria-labelledby="lp-hero-title">
  <div class="landing-hero-content">
    <div class="landing-hero-eyebrow">
      <span>{eyebrow}</span>
    </div>
    <h1 id="lp-hero-title">
      {titleLine1}<em>{titleEm}</em>{titleLine2}
    </h1>
    <p class="landing-hero-intro">
      {intro}
      {introEm && <em>{introEm}</em>}
      {introSuffix && introSuffix}
    </p>
    <div class="landing-hero-cta-group">
      <a
        href="#contact"
        class="btn btn-primary"
        data-track-event="cta_waitlist_clic"
        data-track-source={source}
      >{ctaPrimary}</a>
      <a href="#piliers" class="btn btn-link">{ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .landing-hero {
    min-height: 90vh;
    padding: 10rem 3.5rem 6rem;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    background: linear-gradient(180deg, var(--cream-paper) 0%, var(--cream-light) 100%);
    overflow: hidden;
  }

  /* Cercle décoratif rose */
  .landing-hero::before {
    content: '';
    position: absolute;
    top: -300px;
    right: -300px;
    width: 700px;
    height: 700px;
    border: 1px solid rgba(109, 46, 70, 0.06);
    border-radius: 50%;
    pointer-events: none;
  }

  .landing-hero::after {
    content: '';
    position: absolute;
    bottom: -200px;
    left: -200px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(201, 169, 97, 0.05), transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .landing-hero-content {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .landing-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .landing-hero-eyebrow span {
    font-size: 0.78rem;
    letter-spacing: 0.32em;
    color: var(--berry);
    text-transform: uppercase;
    font-weight: 500;
    padding: 0.5rem 1.5rem;
    border: 1px solid var(--berry);
    border-radius: 100px;
  }

  .landing-hero h1 {
    font-family: 'Cormorant Infant', serif;
    font-size: clamp(2.6rem, 5.5vw, 4.5rem);
    font-weight: 400;
    line-height: 1.05;
    margin-bottom: 2rem;
    color: var(--ink);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .landing-hero h1 em {
    font-style: italic;
    color: var(--berry);
    font-weight: 500;
  }

  .landing-hero-intro {
    font-size: 1.2rem;
    line-height: 1.75;
    color: var(--ink-soft);
    margin: 0 auto 3rem;
    max-width: 640px;
    text-wrap: balance;
  }

  .landing-hero-intro em {
    font-style: italic;
    color: var(--berry);
  }

  .landing-hero-cta-group {
    display: flex;
    gap: 2rem;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 968px) {
    .landing-hero {
      padding: 8rem 1.5rem 4rem;
      min-height: auto;
    }
  }

  @media (max-width: 540px) {
    .landing-hero-cta-group {
      flex-direction: column;
      align-items: stretch;
      gap: 1.2rem;
      width: 100%;
    }
    .landing-hero-cta-group .btn-primary,
    .landing-hero-cta-group .btn-link {
      text-align: center;
    }
  }
</style>
