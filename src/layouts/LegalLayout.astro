---
/**
 * LegalLayout — Layout simplifié pour pages légales / informatives
 * (confidentialité, mentions légales, conditions, etc.)
 *
 * Garde le BaseLayout (SEO, fonts, tracking) mais ajoute :
 *  - Nav et Footer
 *  - Un wrapper <article> typographié pour le contenu juridique
 *  - meta robots "index, follow" mais priorité plus basse (pas critique SEO)
 */

import BaseLayout from "./BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  /** Titre principal H1 affiché en haut de page */
  pageTitle: string;
  /** Sous-titre / chapeau (optionnel) */
  pageSubtitle?: string;
  /** Date d'effet du document (format ISO ou texte libre) */
  effectiveDate?: string;
}

const { title, description, canonicalPath, pageTitle, pageSubtitle, effectiveDate } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <Nav />
  <main id="main-content" class="legal-main">
    <article class="legal-article">
      <header class="legal-header">
        <h1>{pageTitle}</h1>
        {pageSubtitle && <p class="legal-subtitle">{pageSubtitle}</p>}
        {effectiveDate && (
          <p class="legal-effective">
            <span class="legal-effective-label">{Astro.url.pathname.startsWith('/en/') ? 'Effective as of' : 'Date d\'effet'} :</span>
            <time>{effectiveDate}</time>
          </p>
        )}
      </header>
      <div class="legal-content">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  /* Styles globaux pour les pages légales — typographie article */
  .legal-main {
    padding: 8rem 1.5rem 5rem;
    min-height: 100vh;
    background: var(--cream-paper);
  }

  .legal-article {
    max-width: 760px;
    margin: 0 auto;
    background: var(--white);
    padding: 4rem 3.5rem;
    border-radius: 4px;
    box-shadow: 0 20px 60px rgba(74, 31, 48, 0.05);
  }

  .legal-header {
    border-bottom: 1px solid var(--gray-line);
    padding-bottom: 2.5rem;
    margin-bottom: 3rem;
  }

  .legal-header h1 {
    font-family: 'Cormorant Infant', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .legal-subtitle {
    font-size: 1.1rem;
    color: var(--ink-soft);
    font-style: italic;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .legal-effective {
    font-size: 0.85rem;
    color: var(--gray-mid);
    font-style: italic;
  }

  .legal-effective-label {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--berry);
    font-style: normal;
    font-weight: 500;
    margin-right: 0.4rem;
  }

  /* Contenu : typographie article */
  .legal-content {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .legal-content h2 {
    font-family: 'Cormorant Infant', serif;
    font-size: 1.7rem;
    font-weight: 500;
    color: var(--berry);
    margin: 3rem 0 1.2rem;
    line-height: 1.2;
    font-style: italic;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--gray-line);
  }

  .legal-content h2:first-child {
    margin-top: 0;
  }

  .legal-content h3 {
    font-family: 'Cardo', serif;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ink);
    margin: 2rem 0 0.8rem;
    line-height: 1.3;
  }

  .legal-content p {
    margin-bottom: 1.2rem;
  }

  .legal-content p strong {
    color: var(--berry);
    font-weight: 500;
  }

  .legal-content ul {
    margin: 1rem 0 1.5rem 1.5rem;
    padding: 0;
  }

  .legal-content ul li {
    margin-bottom: 0.6rem;
    line-height: 1.65;
    list-style: none;
    position: relative;
    padding-left: 1.2rem;
  }

  .legal-content ul li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--berry);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.4;
  }

  .legal-content a {
    color: var(--berry);
    text-decoration: none;
    border-bottom: 1px solid var(--berry);
    transition: color 0.2s ease;
  }

  .legal-content a:hover {
    color: var(--berry-deep);
  }

  .legal-content em {
    font-style: italic;
    color: var(--berry);
  }

  .legal-content .legal-note {
    background: var(--cream-light);
    padding: 1.2rem 1.5rem;
    border-left: 3px solid var(--berry);
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .legal-back {
    display: inline-block;
    margin-top: 3rem;
    color: var(--berry);
    text-decoration: none;
    font-style: italic;
    border-bottom: 1px solid var(--berry);
    padding: 0.3rem 0;
    transition: padding-right 0.3s ease;
  }

  .legal-back:hover {
    padding-right: 1rem;
  }

  @media (max-width: 768px) {
    .legal-main {
      padding: 6rem 1rem 3rem;
    }
    .legal-article {
      padding: 2.5rem 1.5rem;
    }
  }
</style>
