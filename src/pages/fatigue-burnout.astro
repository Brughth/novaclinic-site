---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingSymptomes from '../components/LandingSymptomes.astro';
import Pillars from '../components/Pillars.astro';
import Parcours from '../components/Parcours.astro';
import Comparatif from '../components/Comparatif.astro';
import Lieu from '../components/Lieu.astro';
import Programmes from '../components/Programmes.astro';
import Founding from '../components/Founding.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Fatigue chronique & Burn-out Lausanne — Centre Novaclinic";
const pageDescription = "Centre dédié à la fatigue chronique et au burn-out des femmes 35-60 ans à Lausanne. Approche fonctionnelle de l'axe HPA, brouillard mental, épuisement persistant. Consultations 90 min, équipe coordonnée. Ouverture sept. 2026.";

const symptoms = [
  { title: 'Fatigue persistante', description: 'Fatigue qui ne passe pas malgré le repos · épuisement matinal · besoin constant de récupérer.' },
  { title: 'Brouillard mental', description: 'Difficultés de concentration · trous de mémoire · lenteur cognitive · perte de mots.' },
  { title: 'Burn-out professionnel', description: 'Épuisement émotionnel · perte de sens · désengagement progressif · cynisme.' },
  { title: 'Axe HPA dérégulé', description: 'Dysfonction hypothalamo-hypophyso-surrénalienne · cortisol à plat ou en pic permanent.' },
  { title: 'Sommeil non récupérateur', description: 'Dormir 8h sans se sentir reposée · réveils nocturnes · sommeil léger · cauchemars.' },
  { title: 'Douleurs diffuses', description: 'Douleurs musculaires et articulaires · sensibilité accrue · fibromyalgie · inflammation chronique.' },
  { title: 'Reprise après burn-out', description: 'Accompagnement structuré pour reprendre le travail durablement, sans rechute.' },
  { title: 'Système immunitaire affaibli', description: 'Infections à répétition · cicatrisation lente · sensibilité accrue aux virus.' },
  { title: 'Anxiété & irritabilité', description: 'Réactions disproportionnées · sentiment d\'être à fleur de peau · charge mentale.' },
];

const medicalConditions = [
  'Chronic fatigue',
  'Burnout',
  'HPA axis dysregulation',
  'Brain fog',
  'Adrenal fatigue',
  'Cognitive impairment',
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/fatigue-burnout"
  medicalConditions={medicalConditions}
>
  <Nav />
  <main id="main-content">
    <LandingHero
      eyebrow="Fatigue chronique · Burn-out"
      titleLine1="Cette fatigue qui ne passe pas, "
      titleEm="on cherche"
      titleLine2=" pourquoi."
      intro="Vous êtes épuisée sans raison apparente. On vous dit que c'est le stress, l'âge, ou que c'est dans la tête. Chez Novaclinic, on relie"
      introEm="fatigue, hormones, stress et sommeil"
      introSuffix=" — parce qu'ils fonctionnent ensemble."
      ctaPrimary="Rejoindre la liste d'attente"
      ctaSecondary="Comprendre notre approche →"
      source="lp_fatigue_burnout"
    />

    <LandingSymptomes
      eyebrow="Symptômes accompagnés"
      titleLine1="Au-delà de "
      titleEm="« c'est le stress »"
      titleLine2="."
      subtitle="La fatigue chronique et le burn-out sont des phénomènes systémiques. Axe HPA, sommeil, hormones, inflammation : tout est lié. Voici les symptômes que nous prenons en charge."
      symptoms={symptoms}
      ctaText="Échanger avec notre équipe →"
    />

    <Pillars />
    <Parcours />
    <Comparatif />
    <Lieu />
    <Programmes />
    <Founding />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
