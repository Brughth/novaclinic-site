---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingSymptomes from '../components/LandingSymptomes.astro';
import Pillars from '../components/Pillars.astro';
import Parcours from '../components/Parcours.astro';
import Comparatif from '../components/Comparatif.astro';
import Lieu from '../components/Lieu.astro';
import Programmes from '../components/Programmes.astro';
import Founding from '../components/Founding.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Ménopause & Périménopause Lausanne — Centre Novaclinic Malley";
const pageDescription = "Centre médical dédié à l'accompagnement de la ménopause et périménopause à Lausanne. Approche fonctionnelle, consultations 90 min, care manager dédiée. Bouffées de chaleur, troubles du sommeil, brouillard mental, dérégulation hormonale. Ouverture sept. 2026.";

// Symptômes spécifiques ménopause/périménopause
const symptoms = [
  { title: 'Bouffées de chaleur', description: 'Symptômes vasomoteurs · sueurs nocturnes · sensations de chaleur soudaines, traités de manière personnalisée.' },
  { title: 'Troubles du sommeil', description: 'Insomnies · réveils nocturnes · sommeil non récupérateur — relier le sommeil à la régulation hormonale.' },
  { title: 'Variations d\'humeur', description: 'Irritabilité · anxiété · épisodes dépressifs — comprendre le lien hormonal et apaiser.' },
  { title: 'Cycle irrégulier', description: 'Saignements abondants · cycles raccourcis ou allongés — accompagner la transition.' },
  { title: 'Prise de poids', description: 'Modifications de la composition corporelle · résistance à l\'insuline — approche systémique.' },
  { title: 'Brouillard mental', description: 'Difficultés de concentration · perte de mémoire à court terme — relier au cerveau hormonal.' },
  { title: 'Libido & sexualité', description: 'Sécheresse · baisse du désir · douleurs — un sujet abordé sans tabou, dans la durée.' },
  { title: 'Densité osseuse', description: 'Prévention ostéoporose · bilan osseux personnalisé · stratégies nutritionnelles et lifestyle.' },
  { title: 'Santé cardiovasculaire', description: 'Risque cardio-métabolique modifié par la ménopause · surveillance proactive.' },
];

// Conditions médicales pour le JSON-LD
const medicalConditions = [
  'Menopause',
  'Perimenopause',
  'Hot flashes treatment',
  'Vasomotor symptoms',
  'Hormonal disorders',
  'Menopausal sleep disorders',
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/menopause"
  medicalConditions={medicalConditions}
>
  <Nav />
  <main id="main-content">
    <LandingHero
      eyebrow="Ménopause · Périménopause"
      titleLine1="La ménopause à Lausanne, "
      titleEm="enfin accompagnée"
      titleLine2=" avec le temps qu'elle mérite."
      intro="Bouffées de chaleur, troubles du sommeil, brouillard mental, hormones qui se dérèglent : ces symptômes méritent mieux que quinze minutes de consultation et trois ordonnances. Novaclinic vous propose"
      introEm="une approche systémique"
      introSuffix=", coordonnée par une care manager dédiée."
      ctaPrimary="Rejoindre la liste d'attente"
      ctaSecondary="Comprendre notre approche →"
      source="lp_menopause"
    />

    <LandingSymptomes
      eyebrow="Symptômes accompagnés"
      titleLine1="Au-delà des "
      titleEm="bouffées de chaleur"
      titleLine2="."
      subtitle="La ménopause est un phénomène systémique. Hormones, sommeil, métabolisme, cerveau, os : tout est lié. Voici les symptômes que nous traitons en profondeur."
      symptoms={symptoms}
      ctaText="Échanger avec notre équipe →"
    />

    <Pillars />
    <Parcours />
    <Comparatif />
    <Lieu />
    <Programmes />
    <Founding />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
