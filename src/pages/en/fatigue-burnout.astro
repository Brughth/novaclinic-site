---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import LandingHero from '../../components/LandingHero.astro';
import LandingSymptomes from '../../components/LandingSymptomes.astro';
import Pillars from '../../components/Pillars.astro';
import Parcours from '../../components/Parcours.astro';
import Comparatif from '../../components/Comparatif.astro';
import Lieu from '../../components/Lieu.astro';
import Programmes from '../../components/Programmes.astro';
import Founding from '../../components/Founding.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Chronic Fatigue & Burnout Lausanne — Novaclinic Center";
const pageDescription = "Center dedicated to chronic fatigue and burnout in women 35-60 in Lausanne. Functional approach to HPA axis, brain fog, persistent exhaustion. 90-min consultations, coordinated team. Opening September 2026.";

const symptoms = [
  { title: 'Persistent fatigue', description: 'Fatigue that does not go away despite rest · morning exhaustion · constant need to recover.' },
  { title: 'Brain fog', description: 'Concentration difficulties · memory lapses · cognitive slowness · word loss.' },
  { title: 'Professional burnout', description: 'Emotional exhaustion · loss of meaning · progressive disengagement · cynicism.' },
  { title: 'HPA axis dysregulation', description: 'HPA dysfunction · flat or chronically spiked cortisol patterns.' },
  { title: 'Non-restorative sleep', description: 'Sleeping 8 hours without feeling rested · night awakenings · light sleep · nightmares.' },
  { title: 'Diffuse pain', description: 'Muscle and joint pain · increased sensitivity · fibromyalgia · chronic inflammation.' },
  { title: 'Recovery after burnout', description: 'Structured support to return to work sustainably, without relapse.' },
  { title: 'Weakened immunity', description: 'Recurring infections · slow healing · increased viral sensitivity.' },
  { title: 'Anxiety & irritability', description: 'Disproportionate reactions · feeling on edge · mental load.' },
];

const medicalConditions = [
  'Chronic fatigue',
  'Burnout',
  'HPA axis dysregulation',
  'Brain fog',
  'Adrenal fatigue',
  'Cognitive impairment',
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/fatigue-burnout"
  medicalConditions={medicalConditions}
>
  <Nav />
  <main id="main-content">
    <LandingHero
      eyebrow="Chronic fatigue · Burnout"
      titleLine1="This fatigue that won't go away, "
      titleEm="we look"
      titleLine2=" for why."
      intro="You are exhausted for no apparent reason. You are told it's stress, age, or that it's in your head. At Novaclinic, we connect"
      introEm="fatigue, hormones, stress and sleep"
      introSuffix=" — because they function together."
      ctaPrimary="Join the waitlist"
      ctaSecondary="Understand our approach →"
      source="lp_fatigue_burnout_en"
    />

    <LandingSymptomes
      eyebrow="Symptoms supported"
      titleLine1="Beyond "
      titleEm="« it's stress »"
      titleLine2="."
      subtitle="Chronic fatigue and burnout are systemic phenomena. HPA axis, sleep, hormones, inflammation: everything is connected. Here are the symptoms we address."
      symptoms={symptoms}
      ctaText="Talk to our team →"
    />

    <Pillars />
    <Parcours />
    <Comparatif />
    <Lieu />
    <Programmes />
    <Founding />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
