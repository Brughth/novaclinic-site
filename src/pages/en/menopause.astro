---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import LandingHero from '../../components/LandingHero.astro';
import LandingSymptomes from '../../components/LandingSymptomes.astro';
import Pillars from '../../components/Pillars.astro';
import Parcours from '../../components/Parcours.astro';
import Comparatif from '../../components/Comparatif.astro';
import Lieu from '../../components/Lieu.astro';
import Programmes from '../../components/Programmes.astro';
import Founding from '../../components/Founding.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Menopause & Perimenopause Lausanne — Novaclinic Malley Center";
const pageDescription = "Medical center dedicated to menopause and perimenopause support in Lausanne. Functional approach, 90-min consultations, dedicated care manager. Hot flashes, sleep disorders, brain fog, hormonal dysregulation. Opening September 2026.";

const symptoms = [
  { title: 'Hot flashes', description: 'Vasomotor symptoms · night sweats · sudden heat sensations, treated in a personalized way.' },
  { title: 'Sleep disorders', description: 'Insomnia · night awakenings · non-restorative sleep — linking sleep to hormonal regulation.' },
  { title: 'Mood swings', description: 'Irritability · anxiety · depressive episodes — understanding the hormonal link and easing it.' },
  { title: 'Irregular cycle', description: 'Heavy bleeding · shortened or extended cycles — supporting the transition.' },
  { title: 'Weight gain', description: 'Body composition changes · insulin resistance — systemic approach.' },
  { title: 'Brain fog', description: 'Concentration difficulties · short-term memory loss — linked to the hormonal brain.' },
  { title: 'Libido & sexuality', description: 'Dryness · decreased desire · pain — addressed without taboo, over time.' },
  { title: 'Bone density', description: 'Osteoporosis prevention · personalized bone assessment · nutritional and lifestyle strategies.' },
  { title: 'Cardiovascular health', description: 'Cardio-metabolic risk modified by menopause · proactive monitoring.' },
];

const medicalConditions = [
  'Menopause',
  'Perimenopause',
  'Hot flashes treatment',
  'Vasomotor symptoms',
  'Hormonal disorders',
  'Menopausal sleep disorders',
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/menopause"
  medicalConditions={medicalConditions}
>
  <Nav />
  <main id="main-content">
    <LandingHero
      eyebrow="Menopause · Perimenopause"
      titleLine1="Menopause in Lausanne, "
      titleEm="finally supported"
      titleLine2=" with the time it deserves."
      intro="Hot flashes, sleep disorders, brain fog, hormones going off track: these symptoms deserve more than fifteen minutes of consultation and three prescriptions. Novaclinic offers you"
      introEm="a systemic approach"
      introSuffix=", coordinated by a dedicated care manager."
      ctaPrimary="Join the waitlist"
      ctaSecondary="Understand our approach →"
      source="lp_menopause_en"
    />

    <LandingSymptomes
      eyebrow="Symptoms supported"
      titleLine1="Beyond "
      titleEm="hot flashes"
      titleLine2="."
      subtitle="Menopause is a systemic phenomenon. Hormones, sleep, metabolism, brain, bones: everything is connected. Here are the symptoms we treat in depth."
      symptoms={symptoms}
      ctaText="Talk to our team →"
    />

    <Pillars />
    <Parcours />
    <Comparatif />
    <Lieu />
    <Programmes />
    <Founding />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
