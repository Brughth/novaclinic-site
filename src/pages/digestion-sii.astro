---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingSymptomes from '../components/LandingSymptomes.astro';
import Pillars from '../components/Pillars.astro';
import Parcours from '../components/Parcours.astro';
import Comparatif from '../components/Comparatif.astro';
import Lieu from '../components/Lieu.astro';
import Programmes from '../components/Programmes.astro';
import Founding from '../components/Founding.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "SII & Troubles digestifs Lausanne — Centre Novaclinic Malley";
const pageDescription = "Centre de médecine fonctionnelle à Lausanne spécialisé dans le syndrome de l'intestin irritable, la dysbiose intestinale et l'axe intestin-cerveau. Bilan microbiote avancé, plan nutrition personnalisé. Ouverture sept. 2026.";

const symptoms = [
  { title: 'Syndrome de l\'intestin irritable', description: 'SII · côlon irritable · alternance constipation-diarrhée · douleurs abdominales chroniques.' },
  { title: 'Ballonnements chroniques', description: 'Ventre gonflé après les repas · sensations de pesanteur · gaz · inconfort permanent.' },
  { title: 'Dysbiose intestinale', description: 'Microbiote déséquilibré · candidose · pullulation bactérienne · SIBO suspecté.' },
  { title: 'Perméabilité intestinale', description: '« Leaky gut » · inflammation de la muqueuse · passage de molécules indésirables.' },
  { title: 'Hypersensibilité viscérale', description: 'Seuil de douleur abaissé · spasmes · communication intestin-cerveau perturbée.' },
  { title: 'Intolérances alimentaires', description: 'Réactions au gluten, lactose, FODMAPs · sensibilités multiples · diagnostic ciblé.' },
  { title: 'Axe intestin-cerveau', description: 'Lien digestion-humeur-anxiété · neurotransmetteurs intestinaux · approche holistique.' },
  { title: 'Inflammation chronique', description: 'Marqueurs inflammatoires élevés · douleurs diffuses · fatigue d\'origine digestive.' },
  { title: 'Plan nutrition personnalisé', description: 'Au-delà des régimes d\'élimination standards : reconstruction progressive de la diversité.' },
];

const medicalConditions = [
  'Irritable Bowel Syndrome',
  'IBS',
  'Gut dysbiosis',
  'Intestinal permeability',
  'Gut-brain axis',
  'Visceral hypersensitivity',
  'Microbiome imbalance',
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/digestion-sii"
  medicalConditions={medicalConditions}
>
  <Nav />
  <main id="main-content">
    <LandingHero
      eyebrow="SII · Troubles digestifs · Dysbiose"
      titleLine1="L'intestin n'est jamais "
      titleEm="seul"
      titleLine2="."
      intro="Ballonnements chroniques, ventre douloureux, alternances constipation-diarrhée. Au Centre Novaclinic, on aborde la digestion via"
      introEm="l'axe intestin-cerveau"
      introSuffix=" et le microbiote, sur la durée."
      ctaPrimary="Rejoindre la liste d'attente"
      ctaSecondary="Comprendre notre approche →"
      source="lp_digestion_sii"
    />

    <LandingSymptomes
      eyebrow="Conditions accompagnées"
      titleLine1="L'approche "
      titleEm="systémique"
      titleLine2=" du digestif."
      subtitle="Le système digestif est une porte d'entrée vers la santé globale. Hormones, humeur, immunité, inflammation : tout transite par l'intestin. Voici ce que nous prenons en charge."
      symptoms={symptoms}
      ctaText="Échanger avec notre équipe →"
    />

    <Pillars />
    <Parcours />
    <Comparatif />
    <Lieu />
    <Programmes />
    <Founding />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
